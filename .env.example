# SQLite local por defecto; para PostgreSQL:
# FIRMADOC_DATABASE_URL=postgresql+psycopg://firmadoc:firmadoc@localhost:5432/firmadoc
FIRMADOC_DATABASE_URL=sqlite:///./firmadoc.db
FIRMADOC_STORAGE_DIR=./data/storage
FIRMADOC_LOCAL_CERT_DIR=./data/local-cert
FIRMADOC_PUBLIC_BASE_URL=http://localhost:8000
FIRMADOC_CHALLENGE_TTL_SECONDS=300
FIRMADOC_MAX_DOCUMENT_BYTES=20971520
FIRMADOC_TRUST_DIR=backend/trust
FIRMADOC_REVOCATION_MODE=soft-fail
FIRMADOC_REVOCATION_FETCH=true
# FIRMADOC_CRL_DIR=backend/trust/crl
# Cotejar el CUIL del certificado con el del firmante de la solicitud (403 cuil_mismatch si difiere).
# Por defecto no: para firmar con token basta un certificado valido y el PIN del token.
FIRMADOC_REQUIRE_CUIL_MATCH=false
FIRMADOC_SIGNING_SECRET=
FIRMADOC_SIGNING_TOKEN_TTL_SECONDS=3600
FIRMADOC_AGENT_URL=http://127.0.0.1:47123
FIRMADOC_WIDGET_DIST=widget/dist
FIRMADOC_WEBHOOK_ALLOW_HTTP=false
FIRMADOC_WEBHOOK_ALLOW_PRIVATE_HOSTS=false
FIRMADOC_WEBHOOK_TIMEOUT_SECONDS=5
FIRMADOC_WEBHOOK_WORKER_ENABLED=true
FIRMADOC_WEBHOOK_POLL_SECONDS=5
FIRMADOC_MAX_BATCH_SIZE=50
# Administracion (vacio = deshabilitada). Generar: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIRMADOC_ADMIN_TOKEN=
# Panel Angular (frontend/): build compilado que se sirve en /panel y origenes extra que pueden embeber
# el widget del panel (solo desarrollo: el servidor de `ng serve`)
FIRMADOC_FRONTEND_DIST=frontend/dist/firmadoc-panel/browser
FIRMADOC_PANEL_ORIGINS=
# Firmante de los PDF cargados desde el panel (con FIRMADOC_REQUIRE_CUIL_MATCH=true, el CUIL del certificado)
FIRMADOC_PANEL_SIGNER_NAME=Operador del panel
FIRMADOC_PANEL_SIGNER_IDENTIFIER=panel
FIRMADOC_PANEL_SIGNER_EMAIL=panel@invalid

FIRMADOC_TSA_URL=
FIRMADOC_TSA_TIMEOUT_SECONDS=10
FIRMADOC_TSA_REQUIRED=false

# Firma remota (firmar). Habilitada solo con la URL base.
FIRMADOC_FIRMAR_BASE_URL=
FIRMADOC_FIRMAR_CLIENT_ID=firmadoc
FIRMADOC_FIRMAR_CLIENT_SECRET=
FIRMADOC_FIRMAR_CALLBACK_SECRET=
FIRMADOC_FIRMAR_TIMEOUT_SECONDS=10
FIRMADOC_FIRMAR_MOCK_ENABLED=false

# Modo real: rehúsa arrancar con configuración insegura, sin firma de demostración ni seed (docs/real-mode.md)
FIRMADOC_REAL_MODE=false
