# SQLite local por defecto; para PostgreSQL:
# FIRMADOC_DATABASE_URL=postgresql+psycopg://firmadoc:firmadoc@localhost:5432/firmadoc
FIRMADOC_DATABASE_URL=sqlite:///./firmadoc.db
FIRMADOC_STORAGE_DIR=./data/storage
FIRMADOC_LOCAL_CERT_DIR=./data/local-cert
FIRMADOC_PUBLIC_BASE_URL=http://localhost:8000
FIRMADOC_CHALLENGE_TTL_SECONDS=300
FIRMADOC_MAX_DOCUMENT_BYTES=20971520
